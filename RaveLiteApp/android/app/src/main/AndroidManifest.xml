<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Rough location, once, for sunrise and the forecast (rounded to ~10 km). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required on Android 13+ to display notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Allows phone-style vibration patterns for reminders. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Slice 5 — Notifee foreground service.
         FOREGROUND_SERVICE itself is brought in by Notifee's own
         manifest, but on API 34+ we must opt into a *type*. We use
         `specialUse` because the ambient always-on screen does not
         match dataSync/health/location/etc. The `health` type would
         require sensor/health runtime permissions we don't use and
         crashes on Android 14 devices (e.g. Redmi A3) at FGS start. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Backup chimes: exact alarms so a chime still fires if the process is
         killed. RaveLite is sideloaded, where USE_EXACT_ALARM is granted at
         install. If it ever ships on Google Play this needs policy review. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Start the chime runtime again after a reboot or an update, without
         waiting for somebody to open the app. See boot/BootReceiver.kt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      <!-- Demo mode, for producing screenshots without photographing
           somebody's real training. No menu mentions it: a button for it
           is a button pressed by accident, by somebody who then thinks
           their history is gone. See domain/demo/. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="ravelite" />
      </intent-filter>
      </activity>
    <!-- Lets a share sheet read one exported file from cache/shared, and
         nothing else. See res/xml/file_paths.xml. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>

      <receiver
        android:name=".boot.BootReceiver"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>
      <service
        android:name=".boot.BootTaskService"
        android:exported="false" />

      <!-- API 34+ requires a foregroundServiceType on the FGS. We
           override Notifee's bundled <service> declaration to add it. -->
      <service
        android:name="app.notifee.core.ForegroundService"
        android:foregroundServiceType="specialUse"
        android:exported="false"
        tools:replace="android:exported">
        <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="ambient_always_on_training_screen" />
      </service>
    </application>
</manifest>
