<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: the dark vertical gradient from RaveLiteIcon.png,
     full-bleed so the icon fills whatever shape the launcher uses. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#000000"
        android:endColor="#1A1A1A"
        android:type="linear" />
</shape>
