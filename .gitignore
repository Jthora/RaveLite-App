# Scratch output from device walks and screenshot runs.
/artifacts/
/screenshots/

# Anything to do with signing or distribution lives in ~/.ravelite,
# never here. This is belt and braces.
*.keystore
!RaveLiteApp/android/app/debug.keystore
*.jks
firebase.env
__pycache__/

# Firebase App Distribution uploads a finished APK; it links nothing into
# the app, so google-services.json is never needed here and must never be
# committed. The README's "nothing is sent anywhere" depends on it.
google-services*.json
